{
  "manifest_version": 3,
  "name": "longform",
  "version": "1.0.0",
  "description": "your reading queue, notes and word look-ups, beside whatever you're reading.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "longform" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "host_permissions": [
    "https://aeon.co/*",
    "https://lithub.com/*",
    "https://www.theparisreview.org/*",
    "https://nautil.us/*",
    "https://orionmagazine.org/*",
    "https://www.thecut.com/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://aeon.co/*",
      "https://lithub.com/*",
      "https://www.theparisreview.org/*",
      "https://nautil.us/*",
      "https://orionmagazine.org/*",
      "https://www.thecut.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
